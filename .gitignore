# Godot 4+ specific ignores
.godot/
/android/

# gdUnit4 CI test-run output (HTML/XML reports, run history) - regenerated every run
/reports/
/addons/gdUnit4/*.tmp

# Python-based pre-commit tooling (gdtoolkit, pre-commit itself)
__pycache__/
*.pyc

# Designer app: per-machine Godot path (tools/designer/README.md)
tools/designer/local_config.json

# Native core (native/README.md): built libraries and build trees, never committed
native/bin/
native/rust/target/

# Per-machine editor and tool state
.vscode/
.playwright-mcp/
