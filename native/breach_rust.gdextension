; Loaded at run time by content/definitions/native_library.gd: always, for the content the
; crate loads (CrateContent, Decision 153), so build it first (native/build.sh). native/
; holds a .gdignore, so the editor never scans it; BREACH_NATIVE picks only the kernels.
[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
linux.x86_64 = "res://native/bin/libbreach_rust.linux.x86_64.so"
windows.x86_64 = "res://native/bin/breach_rust.windows.x86_64.dll"
macos = "res://native/bin/libbreach_rust.macos.universal.dylib"
